{
    "name": "abdulwahhabkhan/device-auth-livewire",
    "description": "Livewire + Alpine frontend for abdulwahhabkhan/device-auth: device verification, confirmation and the device admin screens.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "livewire",
        "alpine",
        "webauthn",
        "passkeys",
        "device",
        "2fa"
    ],
    "homepage": "https://github.com/abdulwahhabkhan/device-auth-livewire",
    "authors": [
        {
            "name": "Abdul Wahhab Khan",
            "homepage": "https://github.com/abdulwahhabkhan"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../laravel-device-auth",
            "options": {
                "symlink": true,
                "versions": {
                    "abdulwahhabkhan/device-auth": "0.1.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "abdulwahhabkhan/device-auth": "^0.1",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.6|^4.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AbdulWahhabKhan\\DeviceAuth\\Livewire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AbdulWahhabKhan\\DeviceAuth\\Livewire\\Tests\\": "tests/",
            "App\\Livewire\\DeviceAuth\\": "stubs/components/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AbdulWahhabKhan\\DeviceAuth\\Livewire\\DeviceAuthLivewireServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint",
        "refactor": "rector",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "test:types": "phpstan analyse --memory-limit=1G",
        "test:unit": "phpunit",
        "test": [
            "@test:lint",
            "@test:refactor",
            "@test:types",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
